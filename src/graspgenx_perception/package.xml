<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>graspgenx_perception</name>
  <version>0.0.0</version>
  <description>GraspGenX 파이프라인 인식 패키지 — YOLO/기하 세그멘테이션, grasp 브릿지</description>
  <maintainer email="wook9980@gmail.com">kimkh</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- graspx 배선 노드(graspgenx_perception/grasp_bridge_node.py)가 쓴다 -->
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- /grasp/compute_grasp (폭 포함 응답). import 실패해도 브리지는 Trigger 로 뜬다 —
       그래도 여기 적는다: 없으면 폭이 FSM 까지 못 간다는 사실이 빌드에 드러나야 한다 -->
  <exec_depend>pick_fsm_msgs</exec_depend>
  <!-- 기본 가중치(resource/yolo11n-seg.pt)를 이 패키지 share 에서 찾는다 -->
  <exec_depend>object_detection</exec_depend>
  <!-- ultralytics·torch 는 rosdep 키가 없고 apt 로 설치하지 않는다.
       도커 이미지에만 들어 있다 — README "실행 환경" 참고. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
