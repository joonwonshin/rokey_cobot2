<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="base_link" params="prefix effector_base:=world has_bracket:=false">
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
        <mass value="0.7" />
        <inertia ixx="1.0E-03" ixy="1.0E-06" ixz="1.0E-06" iyy="1.0E-03" iyz="1.0E-06" izz="1.0E-03" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://onrobot_rg_description/meshes/rg2/visual/base_link.stl" />
        </geometry>
        <material name="">
          <color rgba="0.8 0.8 0.8 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://onrobot_rg_description/meshes/rg2/collision/base_link.stl" />
        </geometry>
      </collision>
    </link>

    <xacro:property name="generate_world" value="${effector_base == 'world'}"/>
    <xacro:if value="${generate_world}">
      <link name="world"/>
    </xacro:if>

    <joint name="joint0" type="fixed">
        <parent link="${effector_base}"/>
        <child link="${prefix}base_link"/>
        <!-- xyz는 effector_base(tool0) 프레임 기준. rpy="1.5708 0 1.5708"가 축을 재배치해서
             child(rg2_base_link)의 접근축(+Z)은 parent(tool0)의 +X로 매핑된다 — 그래서
             브라켓 두께를 X 성분에 더한다(Z가 아니다). 2026-08-07 실측: 브라켓+퀵커넥터
             22 mm(이전 0.004는 출처 불명 추정값). md/context/constraints.md "GraspGenX 관련" 참고 -->
        <xacro:if value="${has_bracket}">
          <origin xyz="0.022 0. 0." rpy="1.5708 0 1.5708" />
        </xacro:if>
        <xacro:unless value="${has_bracket}">
          <origin xyz="0. 0. 0." rpy="1.5708 0 1.5708" />
        </xacro:unless>
    </joint>
    <gazebo reference="${prefix}base_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <selfCollide>false</selfCollide>
      <material>Gazebo/White</material>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="finger_joints" params="prefix fingerprefix reflect">
    <xacro:inner_knuckle_joint prefix="${prefix}" fingerprefix="${fingerprefix}" reflect="${reflect}"/>
    <xacro:inner_finger_joint prefix="${prefix}" fingerprefix="${fingerprefix}"/>
  </xacro:macro>

  <xacro:macro name="finger_links" params="prefix fingerprefix">
    <xacro:outer_knuckle prefix="${prefix}" fingerprefix="${fingerprefix}"/>
    <xacro:inner_knuckle prefix="${prefix}" fingerprefix="${fingerprefix}"/>
    <xacro:inner_finger prefix="${prefix}" fingerprefix="${fingerprefix}"/>
  </xacro:macro>
</robot>
