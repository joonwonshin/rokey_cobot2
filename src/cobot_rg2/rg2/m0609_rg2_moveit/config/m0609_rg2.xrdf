        - center: [-0.0228, -0.2288, -0.0137]
          radius: 0.0226
        - center: [-0.0059, -0.1943, -0.0035]
          radius: 0.0206
        - center: [-0.0003, -0.1662, -0.0019]
          radius: 0.0119
        - center: [-0.1103, -0.3166, -0.0607]
          radius: 0.0070
