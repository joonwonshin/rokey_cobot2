format: xrdf
format_version: 1.0

# ─────────────────────────────────────────────────────────────────────────
# M0609 + OnRobot RG2 — cuMotion(isaac_ros_cumotion) 로봇 기술 파일
#
# ⚠️ 자동 생성 초안이다. 실기 사용 전 아래 3개를 반드시 확인한다:
#   1) 충돌 구 — RViz/Isaac Sim으로 **눈으로 본다**. 아래 geometry: 절 주석 참고
#   2) jerk_limits — joint_limits.yaml에 없어 임의값이다 (UNVERIFIED)
#   3) tool_frames — tool0이다. RG2 TCP가 아니다. §"tool_frames" 주석 참고
#
# 출처: m0609_rg2.srdf(그룹·disable_collisions), joint_limits.yaml(가속도),
#       m0609_with_rg2.urdf.xacro(운동학·mimic), dsr_description2 m0609_collision/*.dae
# ─────────────────────────────────────────────────────────────────────────

modifiers:
  - set_base_frame: "base_link"

# SRDF group_state "all-zeros"(manipulator) + "gripper_open"(gripper).
# mimic 관절은 URDF mimic(multiplier/offset)으로 계산했다 — 손으로 고치지 말 것.
default_joint_positions:
  joint_1: 0.0
  joint_2: 0.0
  joint_3: 0.0
  joint_4: 0.0
  joint_5: 0.0
  joint_6: 0.0
  rg2_finger_joint: -0.558505
  rg2_left_inner_finger_joint: -0.558505
  rg2_left_inner_knuckle_joint: 0.558505
  rg2_right_inner_finger_joint: -0.558505
  rg2_right_inner_knuckle_joint: 0.558505
  rg2_right_outer_knuckle_joint: 0.558505

# cuMotion이 계획하는 관절 = SRDF "manipulator" 그룹(joint_1..joint_6).
# RG2 관절은 계획 대상이 아니다(passive) — 위 default_joint_positions로 고정된다.
cspace:
  joint_names:
    - "joint_1"
    - "joint_2"
    - "joint_3"
    - "joint_4"
    - "joint_5"
    - "joint_6"
  # joint_limits.yaml의 max_acceleration 그대로.
  acceleration_limits: [2.618, 2.618, 3.14, 3.927, 3.927, 3.927]
  # ⚠️ UNVERIFIED: jerk는 joint_limits.yaml에도 URDF에도 없다. ur5e.xrdf의 500.0을 빌려왔다.
  #   너무 크면 궤적이 급격해지고, 너무 작으면 계획이 느려진다. 실기에서 조정할 것.
  jerk_limits: [500.0, 500.0, 500.0, 500.0, 500.0, 500.0]

# ⚠️ tool0은 **플랜지**다. RG2의 파지점(TCP)이 아니다.
#   GraspGenX가 내는 grasp pose는 자기 그리퍼 규약 기준이므로, 그것과 이 프레임 사이
#   정적 변환을 따로 확정해야 한다(계획서 Phase 0-F). 부호 하나로 십수 cm가 어긋난다.
#   확정되면 modifiers에 add_frame으로 grasp_frame을 추가하고 여기를 그걸로 바꾼다.
tool_frames: ["tool0"]

collision:
  geometry: "m0609_rg2_collision_spheres"
  # [튜닝] 환경 장애물과의 여유(m). 크게 잡으면 안전하지만 좁은 틈을 못 지난다.
  buffer_distance:
    base_link: 0.01
    link_1: 0.01
    link_2: 0.01
    link_3: 0.01
    link_4: 0.01
    link_5: 0.01
    link_6: 0.01
    rg2_base_link: 0.01
    rg2_left_outer_knuckle: 0.01
    rg2_left_inner_knuckle: 0.01
    rg2_left_inner_finger: 0.01
    rg2_right_outer_knuckle: 0.01
    rg2_right_inner_knuckle: 0.01
    rg2_right_inner_finger: 0.01

self_collision:
  geometry: "m0609_rg2_collision_spheres"
  buffer_distance:
    base_link: 0.005
    link_1: 0.005
    link_2: 0.005
    link_3: 0.005
    link_4: 0.005
    link_5: 0.005
    link_6: 0.005
    rg2_base_link: 0.005
    rg2_left_outer_knuckle: 0.005
    rg2_left_inner_knuckle: 0.005
    rg2_left_inner_finger: 0.005
    rg2_right_outer_knuckle: 0.005
    rg2_right_inner_knuckle: 0.005
    rg2_right_inner_finger: 0.005
  # SRDF disable_collisions를 그대로 옮긴 것 + 아래 "구 과대추정 보정" 6쌍.
  # SRDF를 고치면 여기도 고친다.
  #
  # 🔴 구 과대추정 보정 6쌍 (2026-08-06, 게이트 E에서 실측하고 추가) — ⚠️ SRDF에는 없다
  # 증상: cuMotion이 all-zeros 시작자세에서 계획 10/10 실패
  #       (`MotionGenStatus.INVALID_START_STATE_SELF_COLLISION`).
  # 진단: `scripts/diag_self_collision.py`가 링크쌍별 침투량을 찍는다. 겹친 25쌍 중
  #       ignore에 없던 6쌍이 아래다(all-zeros 기준 침투량):
  #         base_link ↔ link_2                            77.7 mm
  #         link_4 ↔ rg2_base_link                        49.2 mm
  #         rg2_left_outer_knuckle ↔ rg2_right_inner_knuckle  28.2 mm
  #         rg2_left_inner_knuckle ↔ rg2_right_outer_knuckle  28.2 mm
  #         rg2_base_link ↔ rg2_left_inner_finger         11.9 mm
  #         rg2_base_link ↔ rg2_right_inner_finger        11.1 mm
  # 근거: **같은 자세를 OMPL은 10/10 통과했다.** OMPL은 실제 메시로 충돌을 보고
  #       cuMotion은 이 파일의 구로 본다 → 링크가 겹친 게 아니라 구가 뚱뚱한 것이다.
  #       아래 geometry: 절 주석이 이미 "팔 링크는 실제 단면보다 1.5~2.1배 뚱뚱하다"고 적고 있다.
  # 뒤 4쌍은 전부 그리퍼 내부다. RG2 관절은 cuMotion에서 lock이라 서로 움직이지 않는다 —
  #   검사할 이유 자체가 없다.
  # ⚠️ 앞 2쌍은 실제로 움직이는 쌍이라 보호를 하나 포기한 것이다. 특히
  #   `link_4 ↔ rg2_base_link`(joint_5/6을 접으면 그리퍼가 팔뚝으로 돌아온다)는
  #   **실기 모션 전에 다시 봐야 한다.** 정공법은 ignore가 아니라
  #   base_link·link_2·link_4·rg2_base_link의 구를 다시 피팅하는 것이다(scripts/fit_spheres.py).
  ignore:
    base_link: ["link_1", "link_2"]
    link_1: ["link_2", "link_3"]
    link_2: ["link_3", "link_5", "link_6"]
    link_3: ["link_4", "link_5", "link_6"]
    link_4: ["link_5", "link_6", "rg2_base_link"]
    link_5: ["link_6", "rg2_base_link"]
    link_6: ["rg2_base_link", "rg2_left_outer_knuckle", "rg2_left_inner_knuckle", "rg2_right_outer_knuckle", "rg2_right_inner_knuckle"]
    tool0: ["rg2_base_link"]
    rg2_base_link: ["rg2_left_outer_knuckle", "rg2_left_inner_knuckle", "rg2_right_outer_knuckle", "rg2_right_inner_knuckle", "rg2_left_inner_finger", "rg2_right_inner_finger"]
    rg2_left_outer_knuckle: ["rg2_left_inner_knuckle", "rg2_left_inner_finger", "rg2_right_outer_knuckle", "rg2_right_inner_finger", "rg2_right_inner_knuckle"]
    rg2_left_inner_knuckle: ["rg2_left_inner_finger", "rg2_right_inner_knuckle", "rg2_right_outer_knuckle"]
    rg2_left_inner_finger: ["rg2_right_outer_knuckle", "rg2_right_inner_finger"]
    rg2_right_outer_knuckle: ["rg2_right_inner_knuckle", "rg2_right_inner_finger"]
    rg2_right_inner_knuckle: ["rg2_right_inner_finger"]

# ─────────────────────────────────────────────────────────────────────────
# 충돌 구 — collision/*.dae 정점에서 자동 피팅 (scripts/fit_spheres.py)
#   방법: 링크 최장축을 얇은 슬랩으로 잘라 슬랩마다 구 1개.
#         중심=슬랩 정점 centroid, 반지름=중심거리 97 백분위수.
#   ⚠️ 슬랩당 구 1개라 구는 단면 대각선보다 작아질 수 없다. 팔 링크는 실제 단면보다
#      1.5~2.1배 뚱뚱하다(그리퍼는 1.0~1.4배로 타이트하다 — 파지에 중요한 쪽이다).
#      좁은 틈 계획이 실패하면 해당 링크만 손으로 구를 쪼개 넣는다.
#   ⚠️ 실기 전 반드시 눈으로 확인한다. 구가 링크를 덜 덮으면 로봇이 부딪힌다.
# ─────────────────────────────────────────────────────────────────────────
geometry:
  m0609_rg2_collision_spheres:
    spheres:
      base_link:
        - center: [0.0060, -0.0532, -0.0037]
          radius: 0.0936
        - center: [-0.0092, 0.0189, 0.0068]
          radius: 0.0907
        - center: [0.0008, 0.0900, -0.0063]
          radius: 0.0903
        - center: [-0.0015, 0.0584, 0.0108]
